<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.inference-grid.weekly-report</string>
	<key>ProgramArguments</key>
	<array>
		<string>/path/to/venv/bin/python</string>
		<string>-m</string>
		<string>inference_grid.cli</string>
		<string>--database</string>
		<string>sqlite:////path/to/home/.local/share/inference-grid/board.sqlite</string>
		<string>report</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<!-- 02-C1: every Monday at 07:00. Weekday 1 is Monday in launchd's own
		     0 (Sunday) .. 7 (Sunday) numbering. -->
		<key>Weekday</key>
		<integer>1</integer>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/path/to/home/Library/Logs/inference-grid/weekly-report.log</string>
	<key>StandardErrorPath</key>
	<string>/path/to/home/Library/Logs/inference-grid/weekly-report.log</string>
</dict>
</plist>
