[Unit]
Description=Inference Grid dispatcher supervisor
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/inference-grid/runtime.env
ExecStart=%h/.local/share/inference-grid/venv/bin/inference-grid-service run --state-dir %h/.local/state/inference-grid
Restart=on-failure
RestartSec=15
TimeoutStopSec=15

[Install]
WantedBy=default.target
