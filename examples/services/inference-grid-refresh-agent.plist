<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>local.inference-grid.refresh-agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/path/to/venv/bin/python</string>
		<string>/path/to/inference-grid/deployments/capacity/refresh_agent.py</string>
		<string>/path/to/private/capacity-client.json</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>15</integer>
</dict>
</plist>
