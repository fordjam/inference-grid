@@ -0,0 +1,32 @@
+"""Route handlers for the views API."""
+from starlette.requests import Request
+from starlette.responses import JSONResponse, PlainTextResponse
+
+from ..store import delete_view, list_views, load_view
+
+LIST_PATH = "/api/views"
+
+
+async def handle_views(request: Request):
+    path = request.url.path
+    if path == LIST_PATH:
+        if request.method == "GET":
+            return JSONResponse({"views": list_views()})
+        if request.method == "DELETE":
+            return PlainTextResponse("list deletes are not supported", status_code=405)
+        return PlainTextResponse("method not allowed", status_code=405)
+    if not path.startswith(LIST_PATH + "/"):
+        return PlainTextResponse("not found", status_code=404)
+    name = path[len(LIST_PATH) + 1 :]
+    if request.method == "GET":
+        view = load_view(name)
+        if view is None:
+            return PlainTextResponse("not found", status_code=404)
+        return JSONResponse(view)
+    return PlainTextResponse("method not allowed", status_code=405)
