+# ------------------------------------------ A2 (handoff-5): task aging
+
+NOW = datetime(2026, 9, 13, 12, 0, 0, tzinfo=timezone.utc)
+
+
+def test_age_comes_from_the_tasks_own_timestamp_field():
+    doc = {"tasks": [{"id": "T1", "status": "pending",
+                      "updated_at": "2026-09-01T00:00:00+00:00"}]}
+    task = board_audit.audit_document(doc, "b", roots=(), now=NOW)["tasks"][0]
+    assert task["age_days"] == 12.5
+    assert task["age_source"] == "updated_at"
+
+
+def test_age_falls_back_to_newest_present_evidence_mtime(tmp_path):
+    evidence = tmp_path / "e.md"
+    evidence.write_text("")
+    stamp = (NOW - timedelta(days=3)).timestamp()
+    os.utime(evidence, (stamp, stamp))
+    doc = {"tasks": [{"id": "T1", "status": "blocked",
+                      "evidence": str(evidence),
+                      "plan": str(tmp_path / "gone.md")}]}
+    task = board_audit.audit_document(doc, "b", roots=(), now=NOW)["tasks"][0]
+    assert abs(task["age_days"] - 3.0) < 0.01
+    assert task["age_source"] == "mtime of evidence"
+
+
+def test_age_is_unknown_without_timestamp_or_surviving_evidence(tmp_path):
+    doc = {"tasks": [{"id": "T1", "status": "pending",
+                      "evidence": str(tmp_path / "gone.md")}]}
+    row = board_audit.audit_document(doc, "b", roots=(), now=NOW)
+    task = row["tasks"][0]
+    assert task["age_days"] is None and task["age_source"] == "unknown"
+    oldest = row["oldest_by_status"][0]
+    assert oldest == {"status": "pending", "task": "T1", "age_days": None,
+                      "age_source": "unknown", "unknown": True}
