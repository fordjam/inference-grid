+def parse_at(value) -> datetime | None:
+    if not isinstance(value, str):
+        return None
+    try:
+        return datetime.fromisoformat(value)
+    except ValueError:
+        return None
+
+
+def _mtime_of(raw_path: str) -> float | None:
+    resolved = os.path.expandvars(os.path.expanduser(raw_path))
+    try:
+        return os.stat(resolved).st_mtime
+    except OSError:
+        return None
+
+
+def task_age(task: dict, paths: list[dict], now: datetime) -> tuple:
+    """How old a task is, and what the age stands on: the task's own
+    timestamp field if it has one, else the newest `present` evidence file's
+    mtime (stat only -- the file is never opened), else unknown.
+    Returns (age_days | None, source)."""
+    for key, value in task.items():
+        if str(key).lower() in TASK_TIME_FIELDS:
+            parsed = parse_at(value)
+            if parsed is not None:
+                return round((now - parsed).total_seconds() / 86400, 2), str(key)
+    newest: tuple | None = None
+    for entry in paths:
+        if entry["class"] != "present":
+            continue
+        mtime = _mtime_of(entry["path"])
+        if mtime is not None and (newest is None or mtime > newest[0]):
+            newest = (mtime, entry["field"])
+    if newest is not None:
+        age = (now - datetime.fromtimestamp(newest[0], tz=timezone.utc)) \
+            .total_seconds() / 86400
+        return round(age, 2), f"mtime of {newest[1]}"
+    return None, "unknown"
